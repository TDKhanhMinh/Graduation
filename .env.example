# -----------------------------------------------------------------------------
# NEXT.JS & SUPABASE CONFIGURATION
# -----------------------------------------------------------------------------

# Public Supabase URL (Used by both client and server)
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:44321"

# Public site URL (Used for auth callback URLs and canonical public event URLs)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Public Supabase Publishable Key (Used by Supabase browser/server SSR clients)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key-here"

# Public Supabase Anon Key (Safe to expose to the client)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Cloudflare Turnstile site key (safe for the browser)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-turnstile-site-key"

# -----------------------------------------------------------------------------
# CLOUDINARY PUBLIC UPLOAD CONFIGURATION
# -----------------------------------------------------------------------------

# Cloudinary values safe for browser upload configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_API_KEY="your-api-key"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="VoIPElearning"

# -----------------------------------------------------------------------------
# SERVER-ONLY SECRETS (NEVER expose these to the client via NEXT_PUBLIC_)
# -----------------------------------------------------------------------------

# Service Role Key (Used for admin tasks, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Database Connection String (Direct Postgres connection)
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:44322/postgres"

# Cloudflare Turnstile secret used only by the submit-wish Edge Function
TURNSTILE_SECRET_KEY="your-turnstile-secret-key"

# Random server-only salt used to hash IP and device rate-limit identifiers
WISH_RATE_LIMIT_SALT="replace-with-a-long-random-secret"

# Optional production hostname check for Turnstile responses
TURNSTILE_EXPECTED_HOSTNAME=""

# Optional: Set the node environment (development / production)
NODE_ENV="development"
# Reaction guest cookie signing secret (at least 32 characters; never use NEXT_PUBLIC_* values)
REACTION_SECRET_KEY="replace-with-a-long-random-secret"

# Optional previous signing secret for a short, controlled reaction-cookie rotation window
REACTION_PREVIOUS_SECRET_KEY=""
