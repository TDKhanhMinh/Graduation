# -----------------------------------------------------------------------------
# NEXT.JS & SUPABASE CONFIGURATION
# -----------------------------------------------------------------------------

# Public Supabase URL (Used by both client and server)
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:44321"

# Public site URL (Used for auth callback URLs and canonical public event URLs)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Public Supabase Publishable Key (Used by Supabase browser/server SSR clients)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key-here"

# Public Supabase Anon Key (Safe to expose to the client)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# -----------------------------------------------------------------------------
# SERVER-ONLY SECRETS (NEVER expose these to the client via NEXT_PUBLIC_)
# -----------------------------------------------------------------------------

# Service Role Key (Used for admin tasks, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Database Connection String (Direct Postgres connection)
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:44322/postgres"

# Optional: Set the node environment (development / production)
NODE_ENV="development"
